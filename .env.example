# ==========================================================
# QUADROID 2.0 CONFIGURATION
# ==========================================================

# Operation Mode: 'auto' (detects internet), 'offline' (Ollama only), or 'online'
OPERATION_MODE=auto

# LLM Provider: 'ollama', 'gemini', 'openai', 'groq', or 'nemotron' / 'nvidia'
LLM_PROVIDER=ollama

# Model Name:
# - For NVIDIA Nemotron: nvidia/nemotron-3-nano-30b-a3b, nvidia/llama-3.1-nemotron-70b-instruct
# - For Ollama: llama3.2:3b, qwen2.5:3b, qwen2.5:7b, mistral
# - For OpenAI: gpt-4o-mini, gpt-4o
# - For Gemini: gemini-2.0-flash, gemini-1.5-flash
# - For Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant
LLM_MODEL=llama3.2:3b

# Ollama Endpoint (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Cloud API Keys (Leave blank if running 100% offline with Ollama)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Speech & Voice Settings
# STT Engine: 'faster-whisper' (offline), 'groq' (cloud), or 'google' (default fallback)
STT_ENGINE=google
# Whisper Model size for offline STT: tiny.en, base.en, small.en
FASTER_WHISPER_MODEL=base.en

# TTS Engine: 'edge-tts' (neural online) or 'pyttsx3' (offline SAPI5)
TTS_ENGINE=pyttsx3
# Edge TTS Voice (e.g. en-US-ChristopherNeural, en-US-JennyNeural, en-GB-RyanNeural)
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Identity & Wake-Word
# Optional: Give Quadroid a custom name (e.g., Nova, Jarvis, Friday, Max)
# Leave empty to keep the default name "Quadroid"
# The wake-word automatically matches this name (e.g., "Hey Max", "Hey Jarvis")
NICKNAME=
WAKE_WORD_ENABLED=true
ENABLE_VOICE_FEEDBACK=true

# Desktop GUI Settings
GUI_THEME=dark
GLOBAL_HOTKEY=alt+space
